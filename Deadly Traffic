        self.state = "MENU"
        self.total_credits = 0
        self.score = 0
        self.evaded_count = 0
        self.selected_car_type = 0  
        self.unlocked_cars = {0: True, 1: False, 2: False}

        self.paths = [
            [(30, 150), (400, 150), (600, 300), (790, 300)],
            [(790, 500), (500, 500), (300, 350), (30, 350)],
            [(300, 30), (300, 720)],
            [(600, 720), (600, 30)]
