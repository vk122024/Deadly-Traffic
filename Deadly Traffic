        bridges = [(470, 140, 100, 20), (450, 258, 120, 16), (460, 340, 100, 20), (470, 490, 100, 20), (440, 608, 130, 16)]
        for bx, by, bw, bh in bridges:
            pygame.draw.rect(self.screen, COLOR_BRIDGE, (bx, by, bw, bh))

    def process_gameplay(self):
        self.active_hazards.clear()

        for p in self.projectiles[:]:
            p.update()
            if p.x < 0 or p.x > 830 or p.y < 0 or p.y > SCREEN_HEIGHT:
                self.projectiles.remove(p)
                continue
            
            hit_car = None
            for v in self.vehicles:
                if math.hypot(p.x - v.x, p.y - v.y) < (v.radius + p.radius):
                    hit_car = v
                    break
            if hit_car:
                self.vehicles.remove(hit_car)
                self.projectiles.remove(p)
                self.total_credits += 60
                self.score += 350
                new_v = AIVehicle(random.choice(self.paths))
                self.vehicles.append(new_v)

        for i in range(len(self.vehicles)):
            for j in range(i + 1, len(self.vehicles)):
                v1, v2 = self.vehicles[i], self.vehicles[j]
                dist = math.hypot(v1.x - v2.x, v1.y - v2.y)

                if dist < 42:
                    hazard_x = (v1.x + v2.x) / 2
                    hazard_y = (v1.y + v2.y) / 2
                    self.active_hazards.append((hazard_x, hazard_y))

                    v1.is_in_hazard = True
                    v2.is_in_hazard = True

                    p_dist = math.hypot(self.player.x - hazard_x, self.player.y - hazard_y)
                    if p_dist < 48 and not v1.has_scored:
                        earned = 150
                        self.score += earned
                        self.total_credits += earned
                        self.evaded_count += 1
                        v1.has_scored = True
                        v2.has_scored = True

        for v in self.vehicles:
            if not v.is_in_hazard:
                v.has_scored = False
            v.is_in_hazard = False

        for v in self.vehicles:
            if math.hypot(self.player.x - v.x, self.player.y - v.y) < (self.player.radius + v.radius):
                self.game_over = True

        for t in self.trains:
            t_rect = t.get_rect().inflate(self.player.radius, self.player.radius)
            if t_rect.collidepoint(int(self.player.x), int(self.player.y)):
                self.game_over = True

