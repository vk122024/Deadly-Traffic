        self.screen.blit(subtitle, (SCREEN_WIDTH//2 - subtitle.get_width()//2, 185))

        cred_txt = self.font_title.render(f"Wallet: {self.total_credits} k.kr", True, COLOR_GOLD)
        self.screen.blit(cred_txt, (SCREEN_WIDTH//2 - cred_txt.get_width()//2, 240))

        buttons = [
            ("START SIMULATION", "PLAYING"),
            ("TECH GARAGE & SHOP", "SHOP"),
            ("QUIT", "QUIT")
        ]

        y = 330
        for text, action in buttons:
            rect = pygame.Rect(SCREEN_WIDTH//2 - 180, y, 360, 55)
            is_hovered = rect.collidepoint(mouse_pos)

            bg_col = (35, 60, 90) if is_hovered else (20, 32, 48)
            border_col = COLOR_ACCENT if is_hovered else (60, 85, 115)

            pygame.draw.rect(self.screen, bg_col, rect, border_radius=8)
            pygame.draw.rect(self.screen, border_col, rect, 2, border_radius=8)
            
            txt = self.font_title.render(text, True, COLOR_TEXT if not is_hovered else COLOR_ACCENT)
            self.screen.blit(txt, (rect.centerx - txt.get_width()//2, rect.centery - txt.get_height()//2))

            if mouse_click and is_hovered:
                if action == "PLAYING":
                    self.reset_game()
                    self.state = "PLAYING"
                elif action == "SHOP":
                    self.state = "SHOP"
                elif action == "QUIT":
                    pygame.quit()
                    sys.exit()

            y += 75

