            self.state = "MENU"

    def run(self):
        while True:
            mouse_pos = pygame.mouse.get_pos()
            mouse_click = False

            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    pygame.quit()
                    sys.exit()

                if event.type == pygame.MOUSEBUTTONDOWN:
                    if event.button == 1:  
                        mouse_click = True

                if event.type == pygame.KEYDOWN:
                    if self.state == "PLAYING":
                        if event.key == pygame.K_ESCAPE:
                            self.state = "MENU"
                        elif event.key == pygame.K_SPACE and self.player.car_type == 2 and not self.game_over:
                            b = Bullet(self.player.x, self.player.y, self.player.last_dir_x, self.player.last_dir_y)
                            self.projectiles.append(b)
                        elif event.key == pygame.K_r and self.game_over:
                            self.reset_game()

            # --- ŘÍZENÍ STAVŮ A INTERAKTIVNÍHO GUI ---
            if self.state == "MENU":
                self.run_menu(mouse_pos, mouse_click)

            elif self.state == "SHOP":
                self.run_shop(mouse_pos, mouse_click)

            elif self.state == "PLAYING":
                if not self.game_over:
                    keys = pygame.key.get_pressed()
                    self.player.move(keys)

                    for v in self.vehicles:
                        v.update()
                    for t in self.trains:
                        t.update()

