class Player:
    def __init__(self, x, y, car_type=0):
        self.x = float(x)
        self.y = float(y)
        self.radius = 13
        self.car_type = car_type  
        
        if self.car_type == 0:
            self.speed = 4.8
            self.color = (0, 255, 200)
            self.name = "Sentinel Base (Škoda)"
        elif self.car_type == 1:
            self.speed = 6.8
            self.color = (50, 255, 50)
            self.name = "Aero-Drone MK-II (Praga)"
        elif self.car_type == 2:
            self.speed = 5.5
            self.color = (255, 40, 180)
            self.name = "Combat Interceptor (Tatra)"

        self.last_dir_x = 0
        self.last_dir_y = -1

    def move(self, keys):
        dx, dy = 0, 0
        if keys[pygame.K_LEFT] or keys[pygame.K_a]:
            dx = -1
        if keys[pygame.K_RIGHT] or keys[pygame.K_d]:
            dx = 1
        if keys[pygame.K_UP] or keys[pygame.K_w]:
            dy = -1
        if keys[pygame.K_DOWN] or keys[pygame.K_s]:
            dy = 1

        if dx != 0 or dy != 0:
            length = math.hypot(dx, dy)
            self.last_dir_x = dx / length
            self.last_dir_y = dy / length

        if dx != 0:
            self.x += dx * (self.speed * 0.7 if (dy != 0) else self.speed)
        if dy != 0:
            self.y += dy * (self.speed * 0.7 if (dx != 0) else self.speed)

        self.x = max(20, min(810, self.x))
        self.y = max(20, min(SCREEN_HEIGHT - 20, self.y))

    def draw(self, surface, alpha_surface):
        # Barevná záře kolem hráče
        pygame.draw.circle(alpha_surface, (*self.color[:3], 60), (int(self.x), int(self.y)), self.radius + 12)
        pygame.draw.circle(surface, self.color, (int(self.x), int(self.y)), self.radius)
        pygame.draw.circle(surface, (255, 255, 255), (int(self.x), int(self.y)), 5)

        if self.car_type == 2:
            tip_x = int(self.x + self.last_dir_x * 18)
            tip_y = int(self.y + self.last_dir_y * 18)
            pygame.draw.line(surface, (255, 255, 255), (int(self.x), int(self.y)), (tip_x, tip_y), 3)


class Bullet:
    def __init__(self, x, y, dir_x, dir_y):
        self.x = x
        self.y = y
        self.dir_x = dir_x
        self.dir_y = dir_y
        self.speed = 11.0
        self.radius = 4

    def update(self):
        self.x += self.dir_x * self.speed
        self.y += self.dir_y * self.speed

    def draw(self, surface):
        pygame.draw.circle(surface, (255, 100, 255), (int(self.x), int(self.y)), self.radius)
        pygame.draw.circle(surface, (255, 255, 255), (int(self.x), int(self.y)), 2)


class AIVehicle:
    def __init__(self, path):
        self.path = path
        self.current_target = 1
        self.x = float(path[0][0])
        self.y = float(path[0][1])
        self.speed = random.uniform(2.2, 4.0)
        self.radius = 11
        
        # Přiřazení náhodné značky a barvy z našeho seznamu
        brand_data = random.choice(AI_CAR_BRANDS)
        self.brand_name = brand_data["name"]
        self.color = brand_data["color"]

        self.is_in_hazard = False
        self.has_scored = False

    def update(self):
        target_x, target_y = self.path[self.current_target]
        dx = target_x - self.x
        dy = target_y - self.y
        dist = math.hypot(dx, dy)

        if dist < self.speed:
            self.x = float(target_x)
            self.y = float(target_y)
            self.current_target = (self.current_target + 1) % len(self.path)
        else:
            self.x += (dx / dist) * self.speed
            self.y += (dy / dist) * self.speed

    def draw(self, surface, alpha_surface):
        # Stínová/světelná aura podle značky
        pygame.draw.circle(alpha_surface, (*self.color, 40), (int(self.x), int(self.y)), self.radius + 6)
        # Hlavní tělo vozu
        pygame.draw.circle(surface, self.color, (int(self.x), int(self.y)), self.radius)
        # Středový bod vozu (interiér/sklo)
        pygame.draw.circle(surface, (255, 255, 255), (int(self.x), int(self.y)), 3)


class AITrain:
    def __init__(self, start_x, y_pos, speed):
        self.x = float(start_x)
        self.y = float(y_pos)
        self.speed = speed
        self.length = 80
        self.height = 18

    def update(self):
        self.x += self.speed
        if self.x > 830:
            self.x = -self.length

    def draw(self, surface):
        rect = pygame.Rect(int(self.x), int(self.y), self.length, self.height)
        pygame.draw.rect(surface, (255, 215, 0), rect, border_radius=4)
        # Okénka vlaku
        for wx in range(int(self.x) + 8, int(self.x) + self.length - 10, 14):
            pygame.draw.rect(surface, (20, 20, 40), (wx, int(self.y) + 4, 8, 10), border_radius=2)

    def get_rect(self):
        return pygame.Rect(int(self.x), int(self.y), self.length, self.height)


