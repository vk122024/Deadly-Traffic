    def reset_game(self):
        self.player = Player(400, 350, self.selected_car_type)
        self.vehicles = []
        for i in range(13):
            path = random.choice(self.paths)
            v = AIVehicle(path)
            v.x = float(path[0][0] + (path[1][0] - path[0][0]) * (i / 13.0))
            v.y = float(path[0][1] + (path[1][1] - path[0][1]) * (i / 13.0))
            self.vehicles.append(v)

        self.trains = [
            AITrain(-100, 258, 3.4),
            AITrain(-300, 608, 2.9)
        ]
        self.projectiles = []
        self.active_hazards = []
        self.score = 0
        self.evaded_count = 0
        self.game_over = False

    def draw_map(self):
